    extra_binaries = [
        "//maxcode-rs/bwrap:bwrap",
        "//maxcode-rs/code-mode-host:maxcode-code-mode-host",
        "//maxcode-rs/linux-sandbox:maxcode-linux-sandbox",
        "//maxcode-rs/rmcp-client:test_stdio_server",
        "//maxcode-rs/rmcp-client:test_streamable_http_server",
        "//maxcode-rs/cli:maxcode",
        "//maxcode-rs/windows-sandbox-rs:maxcode-command-runner",
        "//maxcode-rs/windows-sandbox-rs:maxcode-windows-managed-deny-probe",
        "//maxcode-rs/windows-sandbox-rs:maxcode-windows-sandbox-setup",
